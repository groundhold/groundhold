           "type": "string"
          },
          "size": {
           "format": "int64",
           "type": "integer"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "digest",
          "lastUpdateTime",
          "path",
          "revision",
          "url"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "lastHandledReconcileAt": {
        "type": "string"
       },
       "observedGeneration": {
        "format": "int64",
        "type": "integer"
       },
