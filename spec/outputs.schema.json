{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundhold/outputs/v0",
  "title": "Groundhold CLI output shapes (D64)",
  "description": "A $def for each verb whose document a consumer parses TODAY; the set is listed under $defs and is NOT yet every verb — `posture`, `parity` and `apiver` publish documents with no def here, and are registered as debt in TestVerbsPublishingWithoutASchemaDef (D845). The `code` field is the machine contract (spec/errors.md); `reasons` and `explain` are prose and MUST NOT be parsed for control flow. Additive-only: consumers must tolerate unknown fields.",
  "$defs": {
    "code": {
      "type": "string",
      "enum": [
        "structural-error",
        "not-executable",
        "nothing-to-change",
        "observation-required",
        "reconcile-required",
        "reconcile-pending",
        "consent-required",
        "confirmation-required",
        "read-set-mismatch",
        "stale-decision",
        "lease-conflict",
        "clock-regress",
        "binding-conflict",
        "adoption-mismatch",
        "provider-refused",
        "provider-permission-denied",
        "preflight-inconclusive",
        "unsupported-operation",
        "apply-failed",
        "ledger-corrupted",
        "survey-drift",
        "provider-again-later",
        "mapping-schema-drift",
        "reference-invalid",
        "reference-unresolved",
        "unknown-operand",
        "run-unknown",
        "run-running",
        "run-stalled",
        "run-needs-reconcile",
        "run-done",
        "run-failed",
        "wait-timeout"
      ]
    },
    "explain": {
      "description": "stdout of `groundhold explain <code>`. `code` echoes the code asked about, and it is the field this project tells agents to route on (spec/errors.md) — it was emitted from the start and described here only from D867, which is the wrong order for a published contract.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "summary": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        }
      }
    },
    "planRefusal": {
      "description": "stdout on plan exit 2 (D65): exactly one JSON object; the success document is self-discriminating via its top-level plan key",
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "const": "refused"
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verifyReport": {
      "type": "object",
      "required": [
        "specVersion",
        "contractHash",
        "candidateHash",
        "executable",
        "verdicts",
        "summary"
      ],
      "properties": {
        "specVersion": {
          "type": "string"
        },
        "contractHash": {
          "type": "string"
        },
        "candidateHash": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        },
        "blockingReasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisories": {
          "description": "Things groundhold noticed that are NOT verdicts and never affect `executable` — bad practice it can see and would otherwise stay silent about (D365). Present so an AGENT can route on `code` without parsing prose.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "pointer",
              "detail",
              "next"
            ],
            "properties": {
              "code": {
                "description": "Stable machine name, e.g. plaintext-credential or unsubstituted-placeholder.",
                "type": "string"
              },
              "pointer": {
                "description": "Where in the candidate the advisory applies. Never the offending VALUE — an advisory that quotes a secret defeats itself.",
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "next": {
                "description": "What to do instead. An advisory that only alarms leaves the operator where they were.",
                "type": "string"
              }
            }
          }
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "constraint",
              "severity",
              "verdict"
            ],
            "properties": {
              "constraint": {
                "type": "string"
              },
              "subject": {
                "type": "string",
                "description": "capability the verdict is about (D91)"
              },
              "path": {
                "type": "string",
                "description": "attribute path the verdict is about; join key to observations (D91)"
              },
              "verifyMethod": {
                "type": "string",
                "description": "how the constraint can be proven: static | provider-api | probe (D94)"
              },
              "severity": {
                "type": "string"
              },
              "verdict": {
                "enum": [
                  "satisfied",
                  "violated",
                  "unknown",
                  "unverifiable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "basis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "observed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pathInVocabulary": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "summary": {
          "type": "object"
        },
        "contract": {
          "type": "string",
          "description": "The contract's id, as the contract document declares it."
        },
        "contractVersion": {
          "type": "integer",
          "description": "The contract version this report was produced against."
        },
        "candidateFor": {
          "type": "string",
          "description": "The contract id the candidate declares it implements; a mismatch with `contract` is what the load refuses on."
        },
        "code": {
          "$ref": "#/$defs/code",
          "description": "`not-executable` when a blocking verdict stops the plan (D64/D65); absent otherwise."
        }
      }
    },
    "applyResult": {
      "type": "object",
      "required": [
        "status",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "applied",
            "refused",
            "failed",
            "unknown",
            "corrupted"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "runId": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "preflight": {
          "type": "object",
          "description": "D75 permission-preflight outcome on a successful apply",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "inconclusive",
                "skipped"
              ]
            },
            "checked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unattested": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "D78: queried permissions the provider check could not attest (a non-authoritative omission, not a denial)"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "description": "The provider's Retry-After hint on a throttle (provider-again-later) when a driver captured it; converge honours it as the backoff delay. Absent or 0 means no hint (D243)."
        },
        "outputs": {
          "type": "object",
          "description": "Each succeeded create's declared typed outputs, keyed capability -> output name -> value. A projection of results already computed for the receipts, never a new provider read (D283/D316).",
          "additionalProperties": {
            "type": "object"
          }
        },
        "outcomes": {
          "type": "object",
          "description": "Per-action outcome for a fail-isolated run (succeeded|failed|unknown|throttled|skipped), keyed by action id. Present only when at least one action did not succeed — a clean run stays quiet (D379).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reachability": {
          "type": "string",
          "description": "Post-apply edge verdict set by the apply verb, never the executor: reachable (2xx/3xx) | failing (the edge answered 5xx, or TLS did not complete — a failure with no second reading) | unknown (nothing was established: an ambiguous 401/403, DNS, a refused connection, a timeout) | skipped (--no-reachability). Absent when there is no public edge. `failing` and `unknown` are disjoint on purpose (D696): \"this is broken\" is a measurement, \"I could not tell\" is the absence of one, and folding them made a probe that measured nothing read like one that measured success.",
          "enum": [
            "failing",
            "reachable",
            "skipped",
            "unknown"
          ]
        }
      }
    },
    "adoptResult": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "adopted",
            "unadopted",
            "refused"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "runId": {
          "type": "string"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Facts the adoption observed but did not refuse on: an `assumed` declaration the live reading contradicts (D322), an attribute recorded as declared intent because the provider emitted no value for it, and the driver's own account of what it could not read (D555/D556)."
        }
      }
    },
    "resumeResult": {
      "type": "object",
      "required": [
        "status",
        "resolved",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "resumed",
            "still-unknown",
            "nothing-to-resume",
            "refused"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "runId": {
          "type": "string"
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "operationId",
              "operation",
              "status"
            ],
            "properties": {
              "capability": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "providerId": {
                "type": "string"
              }
            }
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        }
      }
    },
    "probeResult": {
      "type": "object",
      "required": [
        "status",
        "measurements",
        "failures",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "partial",
            "probed",
            "refused",
            "unmeasured"
          ],
          "description": "probed (every attempted measurement produced a reading) | partial (some measured, some failed — the failed paths stay unknown and no observation was written for them) | unmeasured (nothing was measured: every attempt failed, or the driver returned none) | refused (the run did not start). D697: `partial` and `unmeasured` exit 2, because a probe is run in order to LEARN something and a run that learned nothing is not a success — they were `probed` with exit 0, which read like one."
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "runId": {
          "type": "string"
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "path",
              "value",
              "method"
            ],
            "properties": {
              "capability": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "intrusive": {
                "type": "boolean"
              }
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "path",
              "method",
              "reason",
              "retryable"
            ]
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        }
      }
    },
    "auditResult": {
      "type": "object",
      "required": [
        "status",
        "verdicts",
        "violations",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "clean",
            "violations-found"
          ]
        },
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "constraint",
              "capability",
              "path",
              "severity",
              "verdict"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "satisfied",
                  "violated",
                  "unknown",
                  "unverifiable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "observedAt": {
                "type": "string"
              },
              "derivation": {
                "type": "string"
              }
            }
          }
        },
        "violations": {
          "type": "integer"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "type": "string",
          "description": "the machine error code for a refusal or a blocking verdict — the fine layer spec/errors.md publishes; absent on a clean run (D624)"
        }
      }
    },
    "convergeResult": {
      "type": "object",
      "required": [
        "status",
        "phases"
      ],
      "properties": {
        "status": {
          "enum": [
            "applied",
            "converged",
            "refused",
            "stale-or-conflict",
            "failed",
            "corrupted"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        },
        "convergence": {
          "type": "string",
          "enum": [
            "verified",
            "inconclusive",
            "unverified"
          ],
          "description": "What the post-apply check actually established. Only `verified` (or a no-op converged status) earns the CONVERGED banner — an applied run whose re-observation could not confirm the world says so instead of claiming it (D136)."
        },
        "reachability": {
          "type": "string",
          "enum": [
            "failing",
            "reachable",
            "skipped",
            "unknown"
          ],
          "description": "Post-apply edge verdict, absent when there is no public edge to probe. A machine field so a script can tell \"up and serving\" from \"up but the edge 403s\" — and, since D696, both of those from \"the edge answered and it is broken\" (failing). The scope of the measurement is stated with the verdict: reachability and HTTP status class only, the response body is not read."
        }
      }
    },
    "discoverResult": {
      "type": "object",
      "required": [
        "discovery",
        "discoveryHash"
      ],
      "properties": {
        "discovery": {
          "type": "object",
          "required": [
            "provider",
            "at",
            "resources"
          ]
        },
        "discoveryHash": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hintsResult": {
      "type": "object",
      "required": [
        "kind",
        "apiVersion",
        "source",
        "hints"
      ],
      "properties": {
        "kind": {
          "const": "AdoptionHints"
        },
        "apiVersion": {
          "const": "hints/v0"
        },
        "source": {
          "type": "object",
          "required": [
            "format"
          ]
        },
        "hints": {
          "type": "array"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exportRecord": {
      "description": "One NDJSON line of `export --format ndjson`",
      "type": "object",
      "required": [
        "index",
        "id",
        "type",
        "event"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "id": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "type": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "event": {
          "type": "object"
        }
      }
    },
    "deposedResult": {
      "type": "object",
      "required": [
        "deposed"
      ],
      "properties": {
        "deposed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "providerId",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "deposed",
                  "pending-delete"
                ]
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "observeResult": {
      "type": "object",
      "required": [
        "observations"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "path",
              "value",
              "source",
              "derivation",
              "observedAt",
              "ttlSeconds"
            ]
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial": {
          "type": "boolean",
          "description": "D242: true when at least one bound capability could not be read this run; observe stays exit 0 (best-effort) and the gap is resolved downstream (verify unknown, plan observation-required)"
        },
        "unreadable": {
          "type": "array",
          "description": "D242: capabilities whose primary read failed this run — NOT observations and never fabricated values; the reason is free diagnostic text (never hashed, never an event)",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "reason"
            ]
          }
        }
      }
    },
    "repairDiagnosis": {
      "type": "object",
      "required": [
        "status",
        "totalEvents",
        "tailEvents",
        "tailLines",
        "validPrefixLines",
        "findings",
        "fingerprint"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "corrupt"
          ]
        },
        "totalEvents": {
          "type": "integer",
          "description": "events in the whole history, compacted base included — the same number attest reports (D654)"
        },
        "tailEvents": {
          "type": "integer",
          "description": "events in the live file; blank lines are not events"
        },
        "baseEvents": {
          "type": "integer",
          "description": "events a compaction moved into the archive"
        },
        "tailLines": {
          "type": "integer",
          "description": "physical lines of the live file — a DIFFERENT unit from the event counts, and the one --quarantine truncates to"
        },
        "validPrefixLines": {
          "type": "integer"
        },
        "fingerprint": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "line",
              "kind",
              "detail",
              "remediation"
            ],
            "properties": {
              "line": {
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "torn-final-line",
                  "unparseable-line",
                  "missing-prev",
                  "chain-broken",
                  "rule-rejected",
                  "bad-timestamp"
                ]
              },
              "capability": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "remediation": {
                "type": "string"
              }
            }
          }
        },
        "code": {
          "type": "string",
          "description": "the machine error code for a refusal or a blocking verdict — the fine layer spec/errors.md publishes; absent on a clean run (D624)"
        }
      }
    },
    "repairResult": {
      "type": "object",
      "required": [
        "status",
        "keptLines",
        "droppedLines",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "repaired",
            "refused"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "keptLines": {
          "type": "integer"
        },
        "droppedLines": {
          "type": "integer"
        },
        "quarantinedTo": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        },
        "findings": {
          "type": "array",
          "description": "What the diagnosis found, in order — the per-event detail behind the status.",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "anchorDocument": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "events",
        "head",
        "heads",
        "decisionHeads"
      ],
      "properties": {
        "apiVersion": {
          "const": "state/v0"
        },
        "kind": {
          "const": "LedgerAnchor"
        },
        "events": {
          "type": "integer"
        },
        "head": {
          "type": "string"
        },
        "heads": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "decisionHeads": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "manifest": {
          "type": "string",
          "description": "Domain-separated hash over the ORDERED list of every live event hash, seeded by the anchored base — the complete forest guard. The positional `head` witnesses only the sub-chain owning the last line (the log is a per-capability forest), so a count-preserving rewrite of any interior event moves the manifest and diverges (D184)."
        },
        "baseEvents": {
          "type": "integer",
          "description": "The compaction position the manifest was seeded at. The manifest is verified only while the ledger's compaction has not advanced past it; beyond that the positional and snapshot checks take over (D137)."
        },
        "ledgerId": {
          "type": "string",
          "description": "The genesis event's canonical hash — the identity signatures bind. A LINEAGE id: forks grown from one genesis share it, and the positional `head` is what tells branches apart (D134)."
        },
        "snapshotHash": {
          "type": "string",
          "description": "When an anchor is cut at a compaction it pins the snapshot document too, so a receiver holding this anchor detects a swapped fold and not only a rewritten tail (D137)."
        },
        "trust": {
          "type": "object",
          "description": "The trust policy the EMITTING process actually verified this ledger under, so any path that loads the anchor arms it and a receiver cannot forget `--trust`. Never emitted unverified — an armed emit refuses at replay first (D135)."
        }
      }
    },
    "anchorCheck": {
      "type": "object",
      "required": [
        "status",
        "anchorEvents",
        "ledgerEvents"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "truncated",
            "diverged"
          ]
        },
        "anchorEvents": {
          "type": "integer"
        },
        "ledgerEvents": {
          "type": "integer"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "publishResult": {
      "type": "object",
      "required": [
        "status",
        "events"
      ],
      "properties": {
        "status": {
          "enum": [
            "published",
            "refused"
          ]
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "contractHash": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "$ref": "#/$defs/explain"
        }
      }
    }
  }
}
