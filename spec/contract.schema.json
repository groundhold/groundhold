{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "groundhold://schemas/contract/v0.1",
  "title": "InfrastructureContract v0.1",
  "type": "object",
  "required": ["apiVersion", "kind", "meta", "capabilities"],
  "properties": {
    "apiVersion": { "const": "contract/v0.1" },
    "kind": { "const": "InfrastructureContract" },
    "meta": {
      "type": "object",
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "owner": { "type": "string" },
        "environment": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "$comment": "closed (D1161): a contract is where a REQUIREMENT is declared, so a key nothing reads is a requirement that never existed while the document validates. `x-` is the escape the top level has published since D673 and it travels with the rule.",
        "patternProperties": { "^x-": {} },
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "type": {
            "description": "The capability types v0.1 recognises. Held equal to the runtime's set and the reference implementation's (D1150) — a third party validating against this file must not be refused a type the tool accepts.",
            "enum": [
              "capability.ai.inference",
              "capability.ai.speech",
              "capability.apigateway.http",
              "capability.audit.trail",
              "capability.authorization.grant",
              "capability.authorization.role",
              "capability.backup.plan",
              "capability.backup.vault",
              "capability.cache.keyvalue",
              "capability.cdn.distribution",
              "capability.certificate.tls",
              "capability.cluster.addon",
              "capability.cluster.kubernetes",
              "capability.cluster.namespace",
              "capability.compute.autoscaling",
              "capability.compute.image",
              "capability.compute.instance",
              "capability.compute.quota",
              "capability.container.job",
              "capability.cost.budget",
              "capability.database.nosql",
              "capability.database.relational",
              "capability.dns.record",
              "capability.dns.zone",
              "capability.email.inbound",
              "capability.email.sending",
              "capability.function.serverless",
              "capability.gitops.application",
              "capability.identity.oauth-client",
              "capability.identity.podidentity",
              "capability.identity.serviceaccount",
              "capability.identity.sso",
              "capability.key.encryption",
              "capability.messaging.kafka",
              "capability.messaging.queue",
              "capability.messaging.topic",
              "capability.monitoring.alert",
              "capability.monitoring.dashboard",
              "capability.monitoring.logmetric",
              "capability.monitoring.logs",
              "capability.monitoring.uptime",
              "capability.network.loadbalancer",
              "capability.network.private",
              "capability.observability.changefeed",
              "capability.registry.image",
              "capability.scheduler.cron",
              "capability.search.index",
              "capability.secret",
              "capability.security.threatdetection",
              "capability.security.waf",
              "capability.storage.block",
              "capability.storage.filesystem",
              "capability.storage.object",
              "capability.streaming.pipe",
              "capability.vpn.gateway",
              "capability.warehouse.analytics",
              "capability.workload.container"
            ]
          },
          "state": {
            "enum": ["active", "retired"],
            "description": "D47: retirement is explicit, never absence"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["op", "value"],
              "properties": {
                "op": { "$ref": "#/$defs/operator" },
                "value": {}
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "hard": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "soft": { "type": "array", "items": { "$ref": "#/$defs/softConstraint" } }
      }
    },
    "budget": { "type": "array", "items": { "$ref": "#/$defs/budgetConstraint" } },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "statement": { "type": "string" },
          "status": { "enum": ["declared", "inferred", "assumed", "unknown"] },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "affects": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
        }
      }
    },
    "autonomy": { "type": "object" },
    "outcomes": {
      "$comment": "reserved in v0 (D1163): NOTHING in the runtime reads this block. It is parsed, shape-gated and folded into the contract's hash, and no verb changes behaviour because of it — `probe` derives what to measure from the ledger's bindings and reads the contract only for the intrusive-probe consent (D59). Declared here rather than left to be inferred, because it appears in a shipped example and a reader who writes it is entitled to know it does nothing yet. Held by TestAReservedBlockChangesNothingButTheHash: adding the block may change the contract's hash and nothing else, so implementing it fails that gate until this marker comes off.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "probe"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "probe": { "enum": ["tcp-connect", "http", "metric", "provider-api"] }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9\\-\\.]*$",
      "maxLength": 128
    },
    "operator": {
      "enum": ["equals", "not-equals", "lte", "gte", "in", "not-in",
               "exists", "absent", "compatible-with", "subset-of"]
    },
    "verify": {
      "type": "object",
      "$comment": "closed (D1162), and it publishes BOTH spellings of a bar. It listed only `method` while the loader has read `design`+`runtime` since D728, so a contract using the two-bar form was valid for the runtime and invalid against this document. Closed because the block is guarded against every wrong VALUE and was blind to a wrong KEY: `method` defaults to `static`, so `vrify:` or `methdo:` silently traded provider evidence for the candidate's own word.",
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["static", "provider-api", "probe"] },
        "design": { "enum": ["static", "provider-api", "probe"] },
        "runtime": { "enum": ["static", "provider-api", "probe"] }
      }
    },
    "constraint": {
      "type": "object",
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "required": ["id", "subject", "path", "op"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string" },
        "op": { "$ref": "#/$defs/operator" },
        "value": {},
        "verify": { "$ref": "#/$defs/verify" }
      }
    },
    "budgetConstraint": {
      "type": "object",
      "$comment": "a constraint that carries its own severity — the loader reads `severity` from a budget entry and defaults it to `hard`, and this file used to point budget at $defs/constraint, which never published the field (D1162). Its own definition rather than a key added to `constraint`, so a HARD constraint cannot carry a severity the runtime would ignore.",
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "required": ["id", "subject", "path", "op"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string" },
        "op": { "$ref": "#/$defs/operator" },
        "value": {},
        "severity": { "enum": ["hard", "soft"] },
        "verify": { "$ref": "#/$defs/verify" }
      }
    },
    "softConstraint": {
      "type": "object",
      "patternProperties": { "^x-": {} },
      "additionalProperties": false,
      "required": ["id", "subject"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string" },
        "op": { "$ref": "#/$defs/operator" },
        "value": {},
        "objective": { "enum": ["minimize", "maximize"] },
        "verify": { "$ref": "#/$defs/verify" }
      }
    }
  }
}
